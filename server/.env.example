PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pixel-perfect-studio
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used once by "npm run seed:admin" to create the first admin account
ADMIN_EMAIL=admin@pixelperfect.studio
ADMIN_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
