PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pixel-perfect-studio
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used once by "npm run seed:admin" to create the first admin account
ADMIN_EMAIL=admin@pixelperfect.studio
ADMIN_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Email notifications (sent via Gmail SMTP) — optional. If unset, the
# server runs fine but no notification/reminder emails are sent.
# SMTP_USER must be a Gmail address, and SMTP_PASS must be a 16-character
# Gmail "App Password" (NOT the normal account password) — see
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on that Google account first).
SMTP_USER=onepixelperfect@gmail.com
SMTP_PASS=change-this-to-a-gmail-app-password
# Where notifications are sent. Defaults to SMTP_USER if unset.
NOTIFY_EMAIL=onepixelperfect@gmail.com

