PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pixel-perfect-studio
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used once by "npm run seed:admin" to create the first admin account
ADMIN_EMAIL=admin@pixelperfect.studio
ADMIN_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Email notifications (sent via Resend) — optional. If unset, the server
# runs fine but no notification/reminder emails are sent.
# Get RESEND_API_KEY from https://resend.com/api-keys after verifying your
# domain in Resend (onepixelperfect.com).
RESEND_API_KEY=re_your_api_key_here
# Must be an address on the verified domain — it doesn't need a real inbox,
# it's only used as the "From" address for outgoing mail.
MAIL_FROM=Pixel Perfect Studio <notifications@onepixelperfect.com>
# Where notifications actually land — this should be a real inbox,
# e.g. your Gmail (forwarded hello@ address or the direct Gmail).
NOTIFY_EMAIL=onepixelperfectstudio@gmail.com

